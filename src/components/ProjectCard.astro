---
import { sitePath } from '../lib/site';

const { project } = Astro.props;
const cardLogo = project.data.logo ?? project.data.image;
const projectSlug = project.id.replace(/\.md$/, '');
const projectLink = sitePath(`/projects/${projectSlug}`);
const cardLogoPath = cardLogo?.startsWith('/') ? sitePath(cardLogo) : cardLogo;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
>
  {
    cardLogo && (
      <div class="flex h-48 items-center justify-center border-b border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-950">
        <img
          src={cardLogoPath}
          alt={`${project.data.title} logo`}
          class="max-h-full max-w-full object-contain"
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col gap-4 p-5">
    <div class="space-y-2">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-400">
        {project.data.year}
      </p>
      <h3 class="text-xl font-semibold text-slate-900 dark:text-white">{project.data.title}</h3>
    </div>

    <p class="text-sm leading-6 text-slate-600 dark:text-slate-300">
      {project.data.shortDescription}
    </p>

    {
      project.data.technologies?.length > 0 && (
        <ul class="flex flex-wrap gap-2 text-xs text-slate-600 dark:text-slate-300">
          {project.data.technologies.map((technology: string) => (
            <li class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 dark:border-slate-700 dark:bg-slate-800">
              {technology}
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-auto flex items-center gap-3 pt-2 text-sm font-medium">
      <a
        href={projectLink}
        class="text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300"
      >
        View project
      </a>
      {
        project.data.github && (
          <a
            href={project.data.github}
            class="text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white"
          >
            GitHub
          </a>
        )
      }
    </div>
  </div>
</article>
