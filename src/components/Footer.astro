---
import siteConfig from '../data/site.json';
import { siteIcons } from '../data/icons';
import type { ImageMetadata } from 'astro';

type FooterLink = { label: string; href: string; icon: [ImageMetadata, ImageMetadata] };

const links = [
  siteConfig.contact.github
    ? { label: 'GitHub', href: siteConfig.contact.github, icon: siteIcons.github }
    : null,
  siteConfig.contact.linkedin
    ? { label: 'LinkedIn', href: siteConfig.contact.linkedin, icon: siteIcons.linkedin }
    : null,
] as Array<FooterLink | null>;
const availableLinks = links.filter(Boolean) as FooterLink[];
---

<footer class="border-t border-slate-200 bg-slate-50 py-8 dark:border-slate-800 dark:bg-slate-950">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-4 px-4 text-sm text-slate-600 sm:px-6 lg:px-8 dark:text-slate-300"
  >
    <div class="flex flex-col justify-between gap-3 md:flex-row md:items-center">
      <p>© {new Date().getFullYear()} {siteConfig.person.name}</p>
      <nav aria-label="Footer links" class="flex flex-wrap gap-4">
        {
          availableLinks.map((link) => (
            <a
              href={link.href}
              class="inline-flex items-center gap-2 hover:text-slate-900 dark:hover:text-white"
            >
              <img src={link.icon[0].src} alt="" class="theme-light-icon h-4 w-4" />
              <img src={link.icon[1].src} alt="" class="theme-dark-icon h-4 w-4" />
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
