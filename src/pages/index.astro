---
import MainLayout from '../layouts/MainLayout.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import Contact from '../components/Contact.astro';
import Sidebar from '../components/Sidebar.astro';
import { getFeaturedProjects, getOtherProjects } from '../lib/site';
import siteConfig from '../data/site.json';

const featuredProjects = await getFeaturedProjects();
const otherProjects = await getOtherProjects();
const sections = [
  { id: 'introduction', label: 'Introduction' },
  { id: 'featured-projects', label: 'Selected projects' },
  { id: 'other-projects', label: 'Other projects' },
  { id: 'contact', label: 'Contact' },
];
---

<MainLayout title={siteConfig.site.title} description={siteConfig.site.description}>
  <Fragment slot="sidebar">
    <Sidebar sections={sections} />
  </Fragment>

  <section class="space-y-6">
    <div
      id="introduction"
      class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900"
    >
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-400">
        Welcome
      </p>
      <h1
        class="mt-3 text-4xl font-black tracking-tight text-slate-900 dark:text-white md:text-5xl"
      >
        {siteConfig.person.name}
      </h1>
      <p class="mt-4 text-xl text-slate-700 dark:text-slate-200">{siteConfig.person.role}</p>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
        {siteConfig.person.shortDescription}
      </p>
    </div>

    <FeaturedProjects projects={featuredProjects} />
    <ProjectCarousel projects={otherProjects} />
    <Contact />
  </section>
</MainLayout>
