---
import MainLayout from '../../layouts/MainLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection, render } from 'astro:content';
import { sitePath } from '../../lib/site';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((report) => ({
    params: { slug: report.id.replace(/\.md$/, '') },
    props: { report },
  }));
}

type ReportEntry = Awaited<ReturnType<typeof getCollection<'reports'>>>[number];
const { report } = Astro.props as { report: ReportEntry };
const { Content } = await render(report);
const body = report.body ?? '';
const sections = [...body.matchAll(/^## (.+)$/gm)].map(([, label]) => ({
  id: label
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, ''),
  label: label.trim(),
}));
---

<MainLayout
  title={`${report.data.title} | ${report.data.project} | Portfolio`}
  description={report.data.shortDescription}
>
  <Fragment slot="sidebar">
    <Sidebar sections={sections} />
  </Fragment>

  <article class="space-y-8">
    <header
      class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900"
    >
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-400">
        {report.data.project} report
      </p>
      <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-900 dark:text-white">
        {report.data.title}
      </h1>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">{report.data.shortDescription}</p>
      <a
        href={sitePath(`/projects/${report.data.projectSlug}/`)}
        class="mt-6 inline-flex text-sm font-medium text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300"
      >
        Back to {report.data.project} project
      </a>
    </header>

    <section class="report-content prose prose-slate max-w-none dark:prose-invert">
      <Content />
    </section>

    <div class="flex justify-center pt-2">
      <a
        href={sitePath(`/projects/${report.data.projectSlug}/`)}
        class="mt-6 inline-flex items-center rounded-full bg-[var(--accent)] px-5 py-3 font-medium text-white hover:bg-[#115e59] dark:bg-sky-600 dark:hover:bg-sky-500"
      >
        Return to {report.data.project} project
      </a>
    </div>
  </article>
</MainLayout>

<script>
  const reportContent = document.querySelector('.report-content');

  if (reportContent) {
    const sectionNodes = Array.from(reportContent.children);
    let currentSection: HTMLElement | null = null;

    sectionNodes.forEach((node) => {
      if (node.tagName === 'H2') {
        currentSection = document.createElement('section');
        currentSection.className = 'report-section';
        reportContent.insertBefore(currentSection, node);
      }

      currentSection?.appendChild(node);
    });
  }
</script>

<style>
  .report-content {
    display: grid;
    gap: 1.5rem;
  }

  .report-content :global(.report-section) {
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--surface);
    padding: 1.5rem;
  }

  .report-content :global(h2) {
    margin: 0;
    color: var(--text);
    font-size: 1.875rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .report-content :global(h3) {
    margin: 2.5rem 0 0;
    border-top: 2px solid var(--border);
    padding-top: 1.25rem;
    color: var(--accent);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .report-content :global(h2 + h3) {
    margin-top: 2rem;
    border-top: 0;
    padding-top: 0;
  }

  .report-content :global(p) {
    margin-top: 1rem;
    color: var(--muted);
    line-height: 1.75;
  }

  .report-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .report-content :global(ul),
  .report-content :global(ol) {
    margin-top: 1rem;
    padding-left: 1.5rem;
    color: var(--muted);
  }

  .report-content :global(ul) {
    list-style: disc;
  }

  .report-content :global(li + li) {
    margin-top: 0.5rem;
  }

  .report-content :global(pre) {
    overflow-x: auto;
    margin-top: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--bg) 88%, var(--accent));
    padding: 1rem;
  }

  .report-content :global(code) {
    color: var(--text);
  }

  .report-content :global(:not(pre) > code) {
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--bg) 88%, var(--accent));
    padding: 0.1em 0.3em;
  }

  .report-content :global(blockquote) {
    margin-top: 1rem;
    border-left: 4px solid var(--accent);
    padding-left: 1.25rem;
    color: var(--muted);
  }

  .report-content :global(pre),
  .report-content :global(blockquote),
  .report-content :global(table) {
    margin-top: 1rem;
  }

  .report-content :global(img) {
    height: auto;
    margin: 1.5rem auto;
  }

  .report-content :global(.report-image-dark) {
    display: none;
  }

  :global(html.dark) .report-content :global(.report-image-light) {
    display: none;
  }

  :global(html.dark) .report-content :global(.report-image-dark) {
    display: block;
  }

  .report-content :global(table) {
    display: block;
    overflow-x: auto;
  }

  .report-content :global(table) {
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }

  .report-content :global(th) {
    background: color-mix(in srgb, var(--accent) 12%, var(--surface));
    color: var(--text);
    font-weight: 700;
  }

  .report-content :global(th),
  .report-content :global(td) {
    min-width: 10rem;
    border-color: var(--border);
    padding: 0.75rem 1rem;
    text-align: left;
    vertical-align: middle;
  }
</style>
