---
import MainLayout from '../layouts/MainLayout.astro';
import { sitePath } from '../lib/site';
---

<MainLayout title="Page not found" description="The requested page could not be found." hideSidebar>
  <section class="not-found-content flex min-h-[50vh] w-full items-center justify-center">
    <div
      class="w-full max-w-3xl rounded-2xl border border-slate-200 bg-white p-10 text-center shadow-sm dark:border-slate-800 dark:bg-slate-900"
    >
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-600 dark:text-sky-400">
        404
      </p>
      <h1 class="mt-4 text-4xl font-black text-slate-900 dark:text-white">
        This page was not found.
      </h1>
      <p class="mt-4 text-slate-600 dark:text-slate-300">
        The link may be broken or the page may have moved.
      </p>
      <a
        href={sitePath('/')}
        class="mt-6 inline-flex items-center rounded-full bg-[var(--accent)] px-5 py-3 text-sm font-medium text-white hover:bg-[#115e59] dark:bg-sky-600 dark:hover:bg-sky-500"
      >
        Back to home
      </a>
    </div>
  </section>
</MainLayout>
